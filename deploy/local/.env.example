# Local development environment configuration
# Copy this file to .env in the repository root:
#   cp deploy/local/.env.example .env

# ─── Required: Supabase ───────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/<id>/settings/api
# Use the DATA API section for the URL and the SERVICE ROLE key (not anon key).
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_KEY=your-local-supabase-service-role-key

# ─── Required: AI Keys ────────────────────────────────────────────────────────
# Used by the agents service and agent work orders for LLM calls.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=

# ─── Required: GitHub (Agent Work Orders) ────────────────────────────────────
# Token needs: repo, workflow scopes.
# Get from: https://github.com/settings/tokens
GITHUB_PAT_TOKEN=

# ─── Service Ports ────────────────────────────────────────────────────────────
HOST=localhost
ARCHON_SERVER_PORT=8181
ARCHON_MCP_PORT=8051
ARCHON_AGENTS_PORT=8052
AGENT_WORK_ORDERS_PORT=8053
ARCHON_UI_PORT=3737

# ─── Feature Flags ────────────────────────────────────────────────────────────
AGENTS_ENABLED=true
ENABLE_AGENT_WORK_ORDERS=true

# ─── Logging ──────────────────────────────────────────────────────────────────
# DEBUG for local dev to surface all errors quickly.
LOG_LEVEL=DEBUG
LOGFIRE_TOKEN=

# ─── Agent Work Orders State ─────────────────────────────────────────────────
# "file" persists state across restarts; "memory" is ephemeral.
STATE_STORAGE_TYPE=file
FILE_STATE_DIRECTORY=agent-work-orders-state

# ─── Service Discovery ────────────────────────────────────────────────────────
# docker_compose: services address each other by container name.
# local: services use localhost with different ports.
SERVICE_DISCOVERY_MODE=docker_compose

# ─── Security ─────────────────────────────────────────────────────────────────
# Keep false — Docker socket mounting is a security risk (CVE-2025-9074).
ENABLE_DOCKER_SOCKET_MONITORING=false
MCP_HEALTH_CHECK_TIMEOUT=5

# ─── Frontend Dev Tools ───────────────────────────────────────────────────────
# Show TanStack Query DevTools in the UI (local dev only).
VITE_SHOW_DEVTOOLS=true
VITE_ALLOWED_HOSTS=

# ─── External Channels (Optional) ────────────────────────────────────────────
# Leave commented out for dry-run local development.
# LEANKIT_TELEGRAM_BOT_TOKEN=
# LEANKIT_TELEGRAM_CHAT_ID=
# LEANKIT_TELEGRAM_WEBHOOK_SECRET=
# LEANKIT_TELEGRAM_NOTIFY_EVENTS=task_review_ready,task_failed,task_escalated
# LEANKIT_TELEGRAM_DIGEST_EVENTS=task_review_ready,approval_requested,external_request_created
# LEANKIT_TELEGRAM_DIGEST_LIMIT=10
# LEANKIT_TELEGRAM_DIGEST_HOUR=9
# LEANKIT_TELEGRAM_DIGEST_MINUTE=0
# LEANKIT_TELEGRAM_DIGEST_TIMEZONE=Asia/Ho_Chi_Minh
# LEANKIT_TELEGRAM_DIGEST_LOOKBACK_MINUTES=1440
# LEANKIT_TELEGRAM_DIGEST_SCHEDULER_ENABLED=false
# LEANKIT_OPENCLAW_INGEST_SECRET=
# LEANKIT_OPENCLAW_REPLAY_WINDOW_MINUTES=30
# LEANKIT_OBSERVABILITY_INGEST_URL=
# LEANKIT_OBSERVABILITY_REPLAY_URL=

# ─── Frontend Proxy ───────────────────────────────────────────────────────────
# false: frontend and API on separate ports (normal local dev).
PROD=false
