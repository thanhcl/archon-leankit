# Production environment configuration
# Copy this file to .env:
#   cp deploy/production/.env.example .env
# Then fill in every value — no defaults are safe in production.

# ─── Required: Supabase ───────────────────────────────────────────────────────
# Use your production Supabase project.
# SERVICE ROLE key required (not the anon/public key).
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_KEY=your-production-service-role-key

# ─── Required: AI Keys ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=

# ─── Required: GitHub (Agent Work Orders) ────────────────────────────────────
# Token needs: repo, workflow scopes.
# Use a dedicated service account token, not a personal token.
GITHUB_PAT_TOKEN=

# ─── Host & Ports ─────────────────────────────────────────────────────────────
# Set HOST to your production domain or IP.
HOST=app.example.com
ARCHON_SERVER_PORT=8181
ARCHON_MCP_PORT=8051
ARCHON_AGENTS_PORT=8052
AGENT_WORK_ORDERS_PORT=8053
ARCHON_UI_PORT=3737

# ─── Feature Flags ────────────────────────────────────────────────────────────
AGENTS_ENABLED=true
ENABLE_AGENT_WORK_ORDERS=true

# ─── Logging ──────────────────────────────────────────────────────────────────
# WARNING or ERROR in production to reduce log volume.
LOG_LEVEL=WARNING
LOGFIRE_TOKEN=

# ─── Agent Work Orders State ─────────────────────────────────────────────────
# Supabase required in production for durable state.
STATE_STORAGE_TYPE=supabase

# ─── Service Discovery ────────────────────────────────────────────────────────
SERVICE_DISCOVERY_MODE=docker_compose

# ─── Security ─────────────────────────────────────────────────────────────────
# Never enable Docker socket monitoring in production.
ENABLE_DOCKER_SOCKET_MONITORING=false
MCP_HEALTH_CHECK_TIMEOUT=10

# ─── Frontend ─────────────────────────────────────────────────────────────────
# DevTools must be off in production.
VITE_SHOW_DEVTOOLS=false
# Whitelist your production domain.
VITE_ALLOWED_HOSTS=app.example.com

# ─── Reverse Proxy Mode ───────────────────────────────────────────────────────
# Set PROD=true to serve UI and API through a single port (reverse proxy setup).
PROD=true

# ─── External Channels ────────────────────────────────────────────────────────
LEANKIT_TELEGRAM_BOT_TOKEN=
LEANKIT_TELEGRAM_CHAT_ID=
LEANKIT_TELEGRAM_WEBHOOK_SECRET=
LEANKIT_TELEGRAM_NOTIFY_EVENTS=task_review_ready,task_failed,task_escalated
LEANKIT_TELEGRAM_DIGEST_EVENTS=task_review_ready,approval_requested,external_request_created
LEANKIT_TELEGRAM_DIGEST_LIMIT=10
LEANKIT_TELEGRAM_DIGEST_HOUR=9
LEANKIT_TELEGRAM_DIGEST_MINUTE=0
LEANKIT_TELEGRAM_DIGEST_TIMEZONE=UTC
LEANKIT_TELEGRAM_DIGEST_LOOKBACK_MINUTES=1440
LEANKIT_TELEGRAM_DIGEST_SCHEDULER_ENABLED=true
LEANKIT_OPENCLAW_INGEST_SECRET=
LEANKIT_OPENCLAW_REPLAY_WINDOW_MINUTES=30
LEANKIT_OBSERVABILITY_INGEST_URL=
LEANKIT_OBSERVABILITY_REPLAY_URL=

# ─── Observability ────────────────────────────────────────────────────────────
# Point to your production observability stack.
# LEANKIT_OBSERVABILITY_INGEST_URL=https://observability.example.com/api/events
# LEANKIT_OBSERVABILITY_REPLAY_URL=https://observability.example.com/api/unified-events/recent
